# Copy to .env on the server (never commit this file).
#
# 1. Message @BotFather, take the bot token.
# 2. Set an invite code so strangers who find the bot cannot subscribe.
# 3. TELEGRAM_CHAT_ID is your own chat id; it seeds you as the owner so the
#    upgrade cannot go silent. Get it from @userinfobot.

TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=0
TELEGRAM_INVITE_CODE=change-me

# ---------------------------------------------------------------------------
# Sizing — every share count in every report derives from these two numbers.
# Leaving them out means the desk assumes Rs 5,00,000 capital and 1% risk,
# which will be wrong for almost everyone.
# ---------------------------------------------------------------------------
TRADING_CAPITAL=500000
RISK_PCT=1.0

# Total open risk allowed across all positions at once. Per-trade sizing is
# blind to this: fifteen positions sized at 1% each is a 15% drawdown.
MAX_HEAT_PCT=6.0

# Used by the charges calculator (zerodha, groww, angelone, upstox, dhan...)
BROKER=zerodha
